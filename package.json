{
  "name": "col-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16" },
  "scripts": {
    "start": "node .github/extensions/col-collector/preview.mjs",
    "test": "node --test tests/*.test.mjs",
